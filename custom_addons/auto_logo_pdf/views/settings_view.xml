<odoo>
    <record id="view_auto_logo_settings" model="ir.ui.view">
        <field name="name">auto.logo.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <div class="app_settings_block" data-string="Auto Logo PDF" string="Auto Logo PDF">
                    <h2>Auto Logo PDF</h2>

                    <div class="row mt16 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="logo_x"/>
                                <div class="text-muted">Horizontal position of the logo</div>
                                <field name="logo_x"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="logo_y"/>
                                <div class="text-muted">Vertical position of the logo</div>
                                <field name="logo_y"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="logo_width"/>
                                <div class="text-muted">Logo width</div>
                                <field name="logo_width"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="logo_height"/>
                                <div class="text-muted">Logo height</div>
                                <field name="logo_height"/>
                            </div>
                        </div>

                    </div>
                </div>

            </xpath>

        </field>
    </record>
</odoo>